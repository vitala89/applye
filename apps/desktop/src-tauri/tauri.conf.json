{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Applye",
  "version": "0.3.0",
  "identifier": "dev.applye.app",
  "build": {
    "frontendDist": "../../dist/apps/desktop/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "nx run desktop:serve",
    "beforeBuildCommand": "nx run desktop:build"
  },
  "app": {
    "windows": [
      {
        "title": "Applye",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
