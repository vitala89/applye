{
  "name": "applye",
  "version": "0.29.1",
  "license": "MIT",
  "private": true,
  "scripts": {
    "desktop:dev": "cd apps/desktop && npx tauri dev",
    "desktop:serve": "nx run desktop:serve",
    "desktop:build": "nx build desktop",
    "desktop:build:tauri": "npm run desktop:build && npm run verify:csp && cd apps/desktop && npx tauri build",
    "web:dev": "nx run web:serve",
    "web:build": "npm run web:analytics-config && npm run web:sitemap && nx build web",
    "web:sitemap": "node apps/web/tools/generate-sitemap.mjs",
    "web:analytics-config": "node apps/web/tools/generate-analytics-config.mjs",
    "web:downloads": "node apps/web/tools/release-downloads.mjs",
    "web:og": "bash apps/web/tools/generate-og.sh",
    "web:deploy": "bash apps/web/tools/deploy.sh",
    "mobile:dev": "echo 'Mobile not scaffolded yet. See apps/mobile/README.md'",
    "test": "nx run-many --target=test",
    "lint": "nx run-many --target=lint",
    "type-check": "nx run-many --target=type-check",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "affected:test": "nx affected --target=test",
    "prepare": "husky",
    "verify:csp": "node tools/verify-csp-compat.mjs"
  },
  "dependencies": {
    "@angular/animations": "~21.2.9",
    "@angular/cdk": "~21.2.0",
