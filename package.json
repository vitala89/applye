    "@nx/eslint": "^23.0.1",
    "@nx/eslint-plugin": "^23.1.0",
    "@nx/jest": "^23.1.0",
    "@nx/js": "^23.1.0",
    "@nx/web": "23.1.0",
    "@nx/workspace": "^23.0.1",
